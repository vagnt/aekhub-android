<?xml version="1.0" encoding="utf-8"?>
<!-- Ζωντανή ειδοποίηση αγώνα, μαζεμένη: σήμα · όνομα · ΣΚΟΡ · όνομα · σήμα -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
    <ImageView android:id="@+id/nb_hlogo" android:layout_width="30dp" android:layout_height="30dp" android:scaleType="fitCenter" />
    <TextView android:id="@+id/nb_home" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:gravity="center_vertical|start" android:maxLines="1" android:ellipsize="end"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="14dp" android:textStyle="bold" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"
        android:gravity="center_horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
        <TextView android:id="@+id/nb_score" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="24dp" android:textStyle="bold"
            android:fontFamily="sans-serif-condensed" android:maxLines="1" />
        <TextView android:id="@+id/nb_min" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" android:textSize="11dp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/nb_away" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginEnd="8dp" android:gravity="center_vertical|end" android:maxLines="1" android:ellipsize="end"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:textSize="14dp" android:textStyle="bold" />
    <ImageView android:id="@+id/nb_alogo" android:layout_width="30dp" android:layout_height="30dp" android:scaleType="fitCenter" />
</LinearLayout>
