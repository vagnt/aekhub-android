<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AEKHub" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>
    <style name="Theme.AEKHub.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_fg</item>
        <item name="postSplashScreenTheme">@style/Theme.AEKHub</item>
    </style>
</resources>
